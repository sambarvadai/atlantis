# Example .env file for local MongoDB logging
#
# Copy this file to `.env` in the project root and replace the placeholder
# values with your own MongoDB Atlas connection details.
#
# NOTE:
# - This file should NOT contain real secrets when committed to git.
# - The running `system_ops_server.py` will load `.env` via python-dotenv.

MONGODB_URI=mongodb+srv://user:password@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=windows_troubleshooter
MONGODB_SESSION_COLLECTION=sessions

